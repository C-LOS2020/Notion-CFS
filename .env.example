# ─── Single workspace ──────────────────────────────────────────────────────────
# Get your integration token at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_integration_token_here
NOTION_WORKSPACE_NAME=default
NOTION_WORKSPACE_DESCRIPTION=My main workspace

# ─── Multiple workspaces (numbered env vars) ───────────────────────────────────
# NOTION_TOKEN_1=secret_bale_token_here
# NOTION_WORKSPACE_NAME_1=bale
# NOTION_WORKSPACE_DESCRIPTION_1=B.A.L.E. content and branding workspace

# NOTION_TOKEN_2=secret_fusion_token_here
# NOTION_WORKSPACE_NAME_2=fusion
# NOTION_WORKSPACE_DESCRIPTION_2=Fusion Superplex operations

# NOTION_TOKEN_3=secret_personal_token_here
# NOTION_WORKSPACE_NAME_3=personal
# NOTION_WORKSPACE_DESCRIPTION_3=Personal notes and reading list

# ─── Or point to a JSON config file ───────────────────────────────────────────
# NOTION_WORKSPACES_CONFIG=./workspaces.json
