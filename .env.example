# ─── Single workspace ──────────────────────────────────────────────────────────
# Get your integration token at https://www.notion.so/my-integrations
# NOTION_TOKEN=secret_your_token_here
# NOTION_WORKSPACE_NAME=default
# NOTION_WORKSPACE_DESCRIPTION=My workspace

# ─── Multiple workspaces (numbered env vars) ───────────────────────────────────
NOTION_TOKEN_1=secret_propane_plus_token
NOTION_WORKSPACE_NAME_1=propane-plus
NOTION_WORKSPACE_DESCRIPTION_1=Propane Plus Bahamas Co. Ltd

NOTION_TOKEN_2=secret_r_and_r_token
NOTION_WORKSPACE_NAME_2=r-and-r
NOTION_WORKSPACE_DESCRIPTION_2=R&R Space

NOTION_TOKEN_3=secret_vmh_token
NOTION_WORKSPACE_NAME_3=vmh
NOTION_WORKSPACE_DESCRIPTION_3=VMH Space (VM Holdings Ltd)

NOTION_TOKEN_4=secret_sgs_token
NOTION_WORKSPACE_NAME_4=sgs
NOTION_WORKSPACE_DESCRIPTION_4=SGS Space (Symphony Global Services)

NOTION_TOKEN_5=secret_gte_token
NOTION_WORKSPACE_NAME_5=gte
NOTION_WORKSPACE_DESCRIPTION_5=GTE Space (Greentech Energy)

NOTION_TOKEN_6=secret_vsb_token
NOTION_WORKSPACE_NAME_6=vsb
NOTION_WORKSPACE_DESCRIPTION_6=VSB Space

NOTION_TOKEN_7=secret_carlos_notion_token
NOTION_WORKSPACE_NAME_7=carlos-notion
NOTION_WORKSPACE_DESCRIPTION_7=Carlos's Notion (Plus Plan)

# ─── Or point to a JSON config file ───────────────────────────────────────────
# NOTION_WORKSPACES_CONFIG=./workspaces.json
